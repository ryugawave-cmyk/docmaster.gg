{
  "name": "docmaster",
  "version": "1.0.0",
  "description": "DocMaster — a modern, all-in-one SaaS platform for working with PDF and documents.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "node scripts/build-static.js",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy",
    "service:install": "node scripts/service-install.js",
    "service:uninstall": "node scripts/service-uninstall.js",
    "vendor:ocr": "node scripts/vendor-ocr.mjs",
    "lint": "echo \"No linter configured yet\" && exit 0",
    "verify:delete": "node scripts/verify-delete.js",
    "verify:font-weight": "node scripts/verify-font-weight.mjs",
    "verify:graphic-regions": "node scripts/verify-graphic-regions.mjs",
    "verify:posbox-click": "node scripts/verify-posbox-click.mjs",
    "verify:posbox-fit": "node scripts/verify-posbox-fit.mjs",
    "verify:positioned-docx": "node scripts/verify-positioned-docx.mjs",
    "test": "node scripts/verify-font-weight.mjs && node scripts/verify-graphic-regions.mjs && node scripts/verify-posbox-click.mjs && node scripts/verify-posbox-fit.mjs && node scripts/verify-positioned-docx.mjs && node scripts/verify-delete.js"
  },
  "keywords": [
    "docmaster",
    "pdf",
    "saas",
    "express",
    "ejs",
    "documents"
  ],
  "author": "DocMaster",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "compression": "^1.7.4",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-ejs-layouts": "^2.5.1",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "pdfjs-dist": "^4.7.76"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "puppeteer-core": "^25.5.0"
  }
}
