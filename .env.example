# ---------------------------------------------
# Advance Office Doc — Environment Configuration Example
# Copy this file to `.env` and adjust as needed.
# ---------------------------------------------

# Server
NODE_ENV=development
PORT=3000
HOST=localhost

# Public site metadata
SITE_NAME=Advance Office Doc
# Set to the real, HTTPS production domain before submitting to AdSense, e.g.
# SITE_URL=https://alvionoffice.com
SITE_URL=http://localhost:3000
SITE_DOMAIN=alvionoffice.com

# Contact / role addresses (create real mailboxes on your domain)
CONTACT_EMAIL=support@alvionoffice.com
PRIVACY_EMAIL=privacy@alvionoffice.com
LEGAL_EMAIL=legal@alvionoffice.com

# Optional social handle (leave blank to hide social links)
TWITTER_HANDLE=

# Cookie-consent banner. Off by default (no analytics/ads = not required).
# Set to true before enabling AdSense/analytics to bring the banner back.
COOKIE_CONSENT=false
