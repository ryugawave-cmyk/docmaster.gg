# ---------------------------------------------
# Advance Office Doc — Environment Configuration Example
# Copy this file to `.env` and adjust as needed.
# ---------------------------------------------

# Server
NODE_ENV=development
PORT=3000
HOST=localhost

# Public site metadata
SITE_NAME=Advance Office Doc
# The single production domain you want Google to show. Canonical URL, og:url,
# sitemap and robots.txt all derive from SITE_URL — keep it to ONE domain.
# For local dev leave it as localhost; the deploy build should use the real one.
SITE_URL=http://localhost:3000
SITE_DOMAIN=advanceofficedoc.com

# Contact / role addresses (create real mailboxes on your domain)
CONTACT_EMAIL=support@advanceofficedoc.com
PRIVACY_EMAIL=privacy@advanceofficedoc.com
LEGAL_EMAIL=legal@advanceofficedoc.com

# Optional social handle (leave blank to hide social links)
TWITTER_HANDLE=

# Cookie-consent banner. Off by default (no analytics/ads = not required).
# Set to true before enabling AdSense/analytics to bring the banner back.
COOKIE_CONSENT=false
