<%
// ============================================================
//  Privacy Policy — premium dark layout (matches the design ref).
//  Styling: public/css/privacy.css (loaded only on "/privacy").
//  Sticky TOC + numbered sections are generated from one array so
//  the contents rail and the body never drift out of sync.
// ============================================================
const hi = {
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/>',
  check:  '<path d="M20 6 9 17l-5-5"/>',
  cal:    '<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>',
  file:   '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/>',
  user:   '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
  chart:  '<path d="M3 3v18h18"/><path d="m7 14 3-3 3 3 5-6"/>',
  cookie: '<path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5Z"/><path d="M8.5 10h.01M12 14h.01M15.5 9h.01M9 15h.01"/>',
  mail:   '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/>',
  arrow:  '<path d="M5 12h14M13 6l6 6-6 6"/>',
};
function ic(name) {
  return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + (hi[name] || hi.file) + '</svg>';
}

const email = site.privacyEmail;
const mail = '<a href="mailto:' + email + '">' + email + '</a>';

const summary = [
  { icon: 'file',   title: 'Files processed',  sub: 'in your browser' },
  { icon: 'user',   title: 'No account',       sub: 'required' },
  { icon: 'chart',  title: 'No analytics',     sub: 'without consent' },
  { icon: 'cookie', title: 'You control',      sub: 'cookie preferences' },
  { icon: 'mail',   title: 'Contact us',       sub: 'anytime' },
];

const sections = [
  { id: 'who', title: 'Who we are', body:
    '<p>' + site.name + ' (&ldquo;we&rdquo;, &ldquo;us&rdquo;, &ldquo;our&rdquo;) provides a free, browser-based toolkit for working with PDFs and documents. This policy applies to our website and in-browser editor. For any privacy question, email ' + mail + '.</p>' },

  { id: 'files', title: 'How your files are handled', body:
    '<p>' + site.name + ' is a client-side application. When you open a file in a tool, it is read and processed <strong>locally on your device, inside your web browser</strong>. Your documents are <strong>not uploaded to our servers</strong>, and we do not receive, view, store or share them.</p>' +
    '<p>While you work, a temporary copy of the document may exist in your browser&rsquo;s memory. Larger files may use your browser&rsquo;s local storage (such as the Origin Private File System) to improve performance. When you close or refresh the tab, these files are removed automatically.</p>' +
    '<p>Because we never receive your files, we cannot recover them for you. Please keep your own backups.</p>' },

  { id: 'collect', title: 'Information we collect', body:
    '<p>We keep data collection to a minimum. Depending on how you use the site, this may include:</p>' +
    '<ul class="pv-dots">' +
      '<li><strong>Server access logs.</strong> Basic technical information such as IP address, browser type, device, referring page and time of request &mdash; used to keep the site secure and reliable.</li>' +
      '<li><strong>Messages you send us.</strong> If you contact us by email or via the contact form, we receive the details you provide (name, email address and message) so we can respond.</li>' +
      '<li><strong>Cookie and consent preferences.</strong> We store your cookie choice in your browser.</li>' +
    '</ul>' +
    '<p>We do not sell your personal information, and we do not build advertising profiles about you.</p>' },

  { id: 'cookies', title: 'Cookies and local storage', body:
    '<p>We use a small amount of browser storage to remember your preferences (such as theme or settings). Only essential cookies are used by default. You can control non-essential cookies through the cookie banner. For full details, see our <a href="/cookies">Cookie Policy</a>.</p>' },

  { id: 'analytics', title: 'Analytics', body:
    '<p>We do not currently use third-party analytics or tracking services to profile visitors. If we add privacy-respecting analytics in the future, we will update this policy and our <a href="/cookies">Cookie Policy</a>, and &mdash; where required &mdash; request your consent first.</p>' },

  { id: 'ads', title: 'Advertising and Google AdSense', body:
    '<p>We may display advertising to help keep ' + site.name + ' free. When advertising is enabled, we use Google AdSense or other trusted third-party vendors that may set cookies to show relevant ads based on a user&rsquo;s prior visits to this and other websites. You can manage your ad preferences in <a href="https://www.google.com/settings/ads" rel="noopener noreferrer" target="_blank">Google Ads Settings</a>. You can also opt out of personalised ads at <a href="https://www.aboutads.info/choices/" rel="noopener noreferrer" target="_blank">aboutads.info/choices</a>.</p>' },

  { id: 'thirdparty', title: 'Third-party services', body:
    '<p>We rely on a small number of third parties to run the site, such as our hosting provider and Google AdSense. These services may process limited technical data (for example, server logs) on our behalf. Fonts and application code are served from our own domain, so your files are not sent to third-party networks.</p>' },

  { id: 'retention', title: 'Data retention', body:
    '<p>We do not store your documents. Server access logs are kept only as long as needed for security and operational purposes. Messages you send us are kept for as long as necessary to handle your request and any follow-up.</p>' },

  { id: 'rights', title: 'Your rights', body:
    '<p>Depending on where you live (for example under the GDPR or CCPA/CPRA), you may have the right to access, correct, delete or restrict the personal information we hold about you, or to object to certain processing. Because we hold very little personal data, most requests relate to messages you have sent us. To exercise your right, email ' + mail + '.</p>' },

  { id: 'children', title: 'Children&rsquo;s privacy', body:
    '<p>' + site.name + ' is not directed to children, and we do not knowingly collect personal information from children. If you believe a child has provided us with personal data, please contact us and we will address it.</p>' },

  { id: 'international', title: 'International users', body:
    '<p>The site can be accessed globally. Where server logs or messages are processed, they may be handled in the country where our hosting provider operates. By using the site you understand that this limited technical information may be processed in those locations.</p>' },

  { id: 'changes', title: 'Changes to this policy', body:
    '<p>We may update this policy as the service evolves or as legal requirements change. When we do, we will revise the &ldquo;Last updated&rdquo; date above. Significant changes will be highlighted on the site where appropriate.</p>' },
];
%>

<!-- ============ HERO ============ -->
<section class="pv-hero">
  <div class="pv-hero__aura" aria-hidden="true"></div>
  <div class="container pv-hero__inner">
    <div class="pv-hero__copy">
      <span class="kicker">Legal</span>
      <h1 class="pv-hero__title">Privacy <span class="grad">Policy</span></h1>
      <p class="pv-hero__sub">
        This policy explains what information <%= site.name %> collects, how your files are
        handled, and the choices you have. In short: your documents are processed in your
        browser and are not uploaded to our servers.
      </p>
      <p class="pv-updated"><span class="pv-updated__ico"><%- ic('cal') %></span>Last updated: <%= lastUpdated %></p>
    </div>

    <div class="pv-hero__visual" aria-hidden="true">
      <div class="pv-shield">
        <span class="pv-shield__badge"><%- ic('shield') %><i class="pv-shield__lock"><%- include('../partials/icon', { name: 'sign' }) %></i></span>
      </div>
      <ul class="pv-checks">
        <li><span class="pv-checks__ico"><%- ic('check') %></span>Private</li>
        <li><span class="pv-checks__ico"><%- ic('check') %></span>Secure</li>
        <li><span class="pv-checks__ico"><%- ic('check') %></span>Under Your Control</li>
      </ul>
      <span class="pv-note">Your<br>Privacy<br>Matters</span>
    </div>
  </div>
</section>

<!-- ============ SHORT VERSION ============ -->
<section class="pv-shortsec">
  <div class="container">
    <div class="pv-short">
      <div class="pv-short__head">
        <span class="pv-short__ico"><%- ic('shield') %></span>
        <div>
          <h2>The short version</h2>
          <p>Your files stay on your device. We do not upload, store or view your documents.</p>
        </div>
      </div>
      <ul class="pv-short__pills">
        <% summary.forEach(function (s) { %>
          <li>
            <span class="pv-short__pillico"><%- ic('check') %></span>
            <span><strong><%= s.title %></strong><small><%= s.sub %></small></span>
          </li>
        <% }); %>
      </ul>
    </div>
  </div>
</section>

<!-- ============ POLICY BODY ============ -->
<section class="pv-bodysec">
  <div class="container pv-layout">
    <!-- Contents rail -->
    <aside class="pv-toc">
      <nav aria-label="Contents">
        <ol>
          <% sections.forEach(function (s, i) { %>
            <li><a href="#<%= s.id %>"><span class="pv-toc__n"><%= i + 1 %>.</span> <%- s.title %></a></li>
          <% }); %>
        </ol>
      </nav>
    </aside>

    <!-- Numbered sections -->
    <div class="pv-sections">
      <% sections.forEach(function (s, i) { %>
        <article class="pv-item" id="<%= s.id %>">
          <span class="pv-item__n"><%= i + 1 %></span>
          <div class="pv-item__body">
            <h2><%- s.title %></h2>
            <%- s.body %>
          </div>
        </article>
      <% }); %>
    </div>
  </div>
</section>

<!-- ============ CONTACT BANNER ============ -->
<section class="pv-bodysec pv-ctasec">
  <div class="container">
    <div class="pv-cta">
      <span class="pv-cta__ico"><%- ic('mail') %></span>
      <div class="pv-cta__copy">
        <h2>Questions about this policy?</h2>
        <p>
          If you have any questions about your data or this Privacy Policy, please contact us at
          <a href="mailto:<%= email %>"><%= email %></a> or visit our <a href="/contact">Contact</a> page.
        </p>
      </div>
      <a href="/contact" class="pv-cta__btn">Contact us <%- ic('arrow') %></a>
    </div>
  </div>
</section>
