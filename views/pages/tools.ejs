<section class="page-hero">
  <div class="container">
    <span class="eyebrow eyebrow--center">Tools</span>
    <h1 class="page-hero__title">The complete <%= site.name %> toolkit</h1>
    <p class="page-hero__lead">
      Everything you need to work with documents — organized, optimized and
      ready whenever you are.
    </p>
  </div>
</section>

<section class="section">
  <div class="container">
    <p class="tools-intro">
      Every tool below runs in your browser — your files are processed on your device and never
      uploaded to our servers. Pick a tool to see how it works, what it supports and how to get
      started, then open it in the editor.
    </p>
    <% Object.keys(groupedTools).forEach(function (category) { %>
      <div class="tool-group">
        <h2 class="tool-group__title"><%= category %></h2>
        <div class="tools-grid">
          <% groupedTools[category].forEach(function (tool) { %>
            <%- include('../partials/tool-card', { tool: tool }) %>
          <% }); %>
        </div>
      </div>
    <% }); %>
  </div>
</section>
