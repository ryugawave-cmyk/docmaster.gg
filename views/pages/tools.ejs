<%
// ============================================================
//  Tools — premium dark SaaS layout (Notion / Linear / Stripe feel)
//  Self-contained: all bespoke icons + card data live here so the
//  layout matches the design exactly. Styling: public/css/tools.css
//  (loaded only on "/tools" — every other page keeps the light theme).
// ============================================================

// Inline icon set (24x24, stroke = currentColor).
const hi = {
  merge:     '<path d="M8 3H5a2 2 0 0 0-2 2v3M3 16v3a2 2 0 0 0 2 2h3M21 8V5a2 2 0 0 0-2-2h-3M16 21h3a2 2 0 0 0 2-2v-3"/><path d="m9 12 3 3 3-3M12 8v7"/>',
  split:     '<path d="M12 3v6m0 6v6"/><path d="M6 9 3 12l3 3M18 9l3 3-3 3"/><path d="M3 12h6m6 0h6"/>',
  organize:  '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><path d="M6.5 14v7M3 17.5h7"/>',
  compress:  '<path d="M4 14h6v6M20 10h-6V4"/><path d="m14 10 7-7M3 21l7-7"/>',
  edit:      '<path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/>',
  document:  '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/><path d="M8 13h8M8 17h5"/>',
  chart:     '<path d="M3 3v18h18"/><rect x="7" y="10" width="3" height="7" rx="1"/><rect x="12.5" y="6" width="3" height="11" rx="1"/><rect x="18" y="13" width="3" height="4" rx="1"/>',
  sign:      '<path d="M3 21c3-1 4-4 4-7 0-2-1-3-2-3s-2 2-1 5c1 4 4 5 6 3 1-1 2-3 3-3s2 2 4 2"/><path d="M18 3l3 3-8 8-4 1 1-4Z"/>',
  convert:   '<path d="M4 8V6a2 2 0 0 1 2-2h9l5 5v9a2 2 0 0 1-2 2h-2"/><path d="m8 13-4 4 4 4"/><path d="M4 17h11"/>',
  excel:     '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M3 15h18M9 3v18M15 3v18"/>',
  image:     '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-4.5-4.5L7 20"/>',
  ai:        '<path d="M12 3v2M12 19v2M5 12H3M21 12h-2M6 6l-1.5-1.5M19.5 19.5 18 18M18 6l1.5-1.5M4.5 19.5 6 18"/><rect x="8" y="8" width="8" height="8" rx="2"/>',
  chat:      '<path d="M21 15a2 2 0 0 1-2 2H8l-4 4V6a2 2 0 0 1 2-2h13a2 2 0 0 1 2 2Z"/><path d="M8.5 10h7M8.5 13h4"/>',
  layout:    '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>',
  translate: '<path d="M4 5h7M8 3v2c0 4-2 7-5 8"/><path d="M6 8c0 3 3 5 6 6"/><path d="m13 20 4-9 4 9M14.5 17h5"/>',
  shield:    '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/>',
  star:      '<path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14l-5-4.87 6.91-1.01Z"/>',
  bolt:      '<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8Z"/>',
  globe:     '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"/>',
  lock:      '<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
  arrow:     '<path d="M5 12h14M13 6l6 6-6 6"/>',
  search:    '<circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/>',
  sparkle:   '<path d="M12 2c.5 4.6 2.8 6.9 7.4 7.4C14.8 9.9 12.5 12.2 12 16.8 11.5 12.2 9.2 9.9 4.6 9.4 9.2 8.9 11.5 6.6 12 2Z"/><path d="M19 14c.2 1.8 1 2.6 2.8 2.8C20 17 19.2 17.8 19 19.6 18.8 17.8 18 17 16.2 16.8 18 16.6 18.8 15.8 19 14Z"/>',
};
function ic(name) {
  return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + (hi[name] || hi.document) + '</svg>';
}

// Category sections — data-driven so the markup stays clean. Every href
// resolves to a real page (a /tools overview or the workspace editor).
const categories = [
  {
    key: 'organize', icon: 'organize', title: 'Organize PDF',
    desc: 'Combine, split, reorder and manage your PDF files.',
    cards: [
      { icon: 'merge',    tint: 'blue',   title: 'Merge PDF',    desc: 'Combine multiple PDFs into one',  href: '/tools/merge-pdf' },
      { icon: 'split',    tint: 'violet', title: 'Split PDF',    desc: 'Separate pages into new files',    href: '/tools/split-pdf' },
      { icon: 'organize', tint: 'green',  title: 'Organize PDF', desc: 'Reorder, rotate and delete pages', href: '/tools/organize-pdf' },
      { icon: 'compress', tint: 'rose',   title: 'Compress PDF', desc: 'Reduce file size, keep quality',   href: '/tools/compress-pdf' },
    ],
  },
  {
    key: 'edit', icon: 'edit', title: 'Edit & Create',
    desc: 'Tools to edit, create and enhance your documents.',
    cards: [
      { icon: 'edit',     tint: 'amber',  title: 'Edit PDF',        desc: 'Add text, images and shapes',    href: '/tools/edit-pdf' },
      { icon: 'document', tint: 'blue',   title: 'New Document',    desc: 'Create and format documents',    href: '/workspace?view=document' },
      { icon: 'chart',    tint: 'sky',    title: 'Charts & Graphs', desc: 'Insert editable charts & graphs', href: '/tools/charts-graphs' },
      { icon: 'sign',     tint: 'teal',   title: 'Sign PDF',        desc: 'Add legally binding signatures', href: '/tools/sign-pdf' },
    ],
  },
  {
    key: 'convert', icon: 'convert', title: 'Convert & Optimize',
    desc: 'Convert between formats and optimize your files.',
    cards: [
      { icon: 'convert',  tint: 'cyan',   title: 'Convert PDF',           desc: 'To and from Word, Excel, images', href: '/tools/convert-pdf' },
      { icon: 'excel',    tint: 'green',  title: 'Excel & Spreadsheets',  desc: 'Convert and export to Excel', href: '/tools/excel-spreadsheet', badge: 'Beta' },
      { icon: 'compress', tint: 'rose',   title: 'Compress PDF',          desc: 'Smaller size, better sharing', href: '/tools/compress-pdf' },
      { icon: 'image',    tint: 'pink',   title: 'Image Tools',           desc: 'Convert, resize and optimize', href: '/tools/convert-pdf' },
    ],
  },
  {
    key: 'ai', icon: 'sparkle', title: 'AI Document Tools',
    desc: 'AI-powered tools to work smarter.',
    cards: [
      { icon: 'ai',        tint: 'violet', title: 'AI Document Tools', desc: 'Summarize, rewrite, generate', href: '/tools/ai-document-tools', badge: 'Preview' },
      { icon: 'chat',      tint: 'pink',   title: 'AI PDF Chat',       desc: 'Ask questions about your docs', href: '/tools/ai-document-tools' },
      { icon: 'layout',    tint: 'blue',   title: 'Smart Layout',      desc: 'Detect and improve layout', href: '/tools/ai-document-tools' },
      { icon: 'translate', tint: 'teal',   title: 'Translate Document', desc: 'Translate PDFs and documents', href: '/tools/ai-document-tools' },
    ],
  },
];
%>

<!-- ============ HERO ============ -->
<section class="hx">
  <div class="hx__aura" aria-hidden="true"></div>
  <div class="container hx__inner">
    <div class="hx__copy">
      <span class="hx__badge"><span class="hx__badge-dot"></span> All-in-One Document Workspace</span>
      <h1 class="hx__title">
        Edit, Convert and Create Documents
        <span class="grad">in Your Browser</span>
      </h1>
      <p class="hx__sub">
        Professional PDF, Word, Excel and AI document tools. Fast, private and
        powered entirely in your browser.
      </p>
      <div class="hx__actions">
        <a href="/workspace" class="btn btn-purple btn-lg">Open Editor <span class="btn__ico"><%- ic('arrow') %></span></a>
        <a href="#all-tools" class="btn btn-glass btn-lg">Explore Tools</a>
      </div>

      <ul class="trust">
        <li class="trust__card">
          <span class="trust__ico"><%- ic('shield') %></span>
          <span><strong>100% Private</strong><small>Files stay on your device</small></span>
        </li>
        <li class="trust__card">
          <span class="trust__ico"><%- ic('bolt') %></span>
          <span><strong>No Installation</strong><small>Works in your browser</small></span>
        </li>
        <li class="trust__card">
          <span class="trust__ico"><%- ic('globe') %></span>
          <span><strong>Works Everywhere</strong><small>Windows, Mac, Linux</small></span>
        </li>
        <li class="trust__card">
          <span class="trust__ico"><%- ic('sparkle') %></span>
          <span><strong>AI Powered</strong><small>Smart document tools</small></span>
        </li>
      </ul>
    </div>

    <!-- Editor mockup (decorative) -->
    <div class="hx__visual" aria-hidden="true">
      <div class="mock">
        <div class="mock__bar">
          <span class="mock__brand"><span class="mock__logo"></span> Advance Office Doc</span>
          <span class="mock__dots"><i></i><i></i><i></i></span>
        </div>
        <div class="mock__body">
          <aside class="mock__rail">
            <span class="mock__tool is-on"><%- ic('edit') %></span>
            <span class="mock__tool"><%- ic('image') %></span>
            <span class="mock__tool"><%- ic('organize') %></span>
            <span class="mock__tool"><%- ic('sign') %></span>
            <span class="mock__tool"><%- ic('chart') %></span>
          </aside>
          <div class="mock__page">
            <div class="mock__toolbar"><i></i><i></i><i></i><i class="w"></i><i></i></div>
            <h3 class="mock__h">Professional Documents <span class="grad">Made Simple</span></h3>
            <p class="mock__p">Create. Edit. Collaborate. All in one place.</p>
            <div class="mock__hero"></div>
            <span class="mock__line"></span>
            <span class="mock__line short"></span>
          </div>
          <aside class="mock__props">
            <span class="mock__prop-h">Text Properties</span>
            <span class="mock__field"></span>
            <span class="mock__field"></span>
            <div class="mock__swatches"><i></i><i></i><i></i><i></i></div>
            <span class="mock__field slim"></span>
          </aside>
        </div>
      </div>
      <div class="mock__chip">
        <span class="mock__chip-ico"><%- ic('sparkle') %></span>
        Edit PDFs, images and text right in your browser
      </div>
    </div>
  </div>
</section>

<!-- ============ TOOLS ============ -->
<section class="tsec" id="all-tools">
  <div class="container">
    <div class="tsec__head">
      <div>
        <span class="kicker">Document Tools</span>
        <h2 class="tsec__title">Everything You Need, <span class="grad">In One Place</span></h2>
        <p class="tsec__lead">Powerful tools to work with PDFs, documents, spreadsheets and more — all in your browser.</p>
      </div>
      <a href="/workspace" class="searchbox" aria-label="Open the editor">
        <span class="searchbox__ico"><%- ic('search') %></span>
        <span class="searchbox__ph">Search tools…</span>
      </a>
    </div>

    <!-- Featured (bento) -->
    <div class="cat__label">
      <span class="cat__ico cat__ico--star"><%- ic('star') %></span>
      <span><strong>Featured Tools</strong><small>Our most popular tools, built for productivity.</small></span>
    </div>

    <div class="bento">
      <a href="/workspace?view=pdf" class="bento__big">
        <div class="bento__big-top">
          <span class="tcard__ico tint-rose"><%- ic('document') %></span>
          <span class="tag tag--hot">Most Popular</span>
        </div>
        <h3>PDF Editor</h3>
        <p>Edit text, images, shapes and more directly inside your PDF files — no upload required.</p>
        <span class="bento__cta">Open Editor <%- ic('arrow') %></span>
        <span class="bento__ghost" aria-hidden="true"><%- ic('document') %></span>
      </a>

      <a href="/tools/convert-pdf" class="bento__card">
        <span class="tcard__ico tint-blue"><%- ic('convert') %></span>
        <h3>PDF to Word</h3>
        <p>Convert PDF to editable DOCX with high accuracy.</p>
        <span class="bento__cta">Try Now <%- ic('arrow') %></span>
      </a>

      <a href="/tools/excel-spreadsheet" class="bento__card">
        <span class="tcard__ico tint-green"><%- ic('excel') %></span>
        <h3>PDF to Excel</h3>
        <p>Extract and convert tables to Excel instantly.</p>
        <span class="bento__cta">Try Now <%- ic('arrow') %></span>
      </a>
    </div>

    <!-- Category rows -->
    <% categories.forEach(function (cat) { %>
      <section class="cat">
        <div class="cat__head">
          <div class="cat__label">
            <span class="cat__ico cat__ico--<%= cat.key %>"><%- ic(cat.icon) %></span>
            <span><strong><%= cat.title %></strong><small><%= cat.desc %></small></span>
          </div>
          <a href="/tools" class="cat__all">View all <%- ic('arrow') %></a>
        </div>
        <div class="cat__grid">
          <% cat.cards.forEach(function (card) { %>
            <a href="<%= card.href %>" class="tcard">
              <span class="tcard__ico tint-<%= card.tint %>"><%- ic(card.icon) %></span>
              <span class="tcard__body">
                <span class="tcard__title"><%= card.title %><% if (card.badge) { %><span class="tag"><%= card.badge %></span><% } %></span>
                <span class="tcard__desc"><%= card.desc %></span>
              </span>
              <span class="tcard__arrow"><%- ic('arrow') %></span>
            </a>
          <% }); %>
        </div>
      </section>
    <% }); %>
  </div>
</section>

<!-- ============ PRIVACY ============ -->
<section class="privsec">
  <div class="container privsec__inner">
    <div class="privsec__copy">
      <span class="kicker"><span class="kicker__dot"></span> Privacy by design</span>
      <h2 class="privsec__title">Your Files Stay <span class="grad">On Your Device</span></h2>
      <p class="privsec__lead">
        <%= site.name %> processes documents directly in your browser whenever possible.
        Your files remain under your control — never uploaded to a server, never stored by us.
      </p>
      <div class="privsec__badges">
        <span class="pill"><span class="pill__ico"><%- ic('lock') %></span> Local Processing</span>
        <span class="pill"><span class="pill__ico"><%- ic('shield') %></span> No File Uploads</span>
      </div>
      <div class="privsec__actions">
        <a href="/security" class="btn btn-purple">How we keep you safe</a>
        <a href="/privacy" class="btn btn-glass">Read the Privacy Policy</a>
      </div>
    </div>
    <div class="privsec__art" aria-hidden="true">
      <div class="privsec__orbit">
        <span class="privsec__shield"><%- ic('shield') %></span>
      </div>
    </div>
  </div>
</section>

<!-- ============ CTA ============ -->
<section class="ctasec">
  <div class="container">
    <div class="ctacard">
      <span class="ctacard__ico"><%- ic('sparkle') %></span>
      <div class="ctacard__copy">
        <h2>Work Smarter With <%= site.name %></h2>
        <p>Create, edit, convert and manage documents without installing software.</p>
      </div>
      <a href="/workspace" class="btn btn-onpurple btn-lg">Get Started Free <%- ic('arrow') %></a>
    </div>
  </div>
</section>
