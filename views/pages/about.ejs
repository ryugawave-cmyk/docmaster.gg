<%
// ============================================================
//  About — premium dark layout (matches the design ref).
//  Styling: public/css/about.css (loaded only on "/about").
// ============================================================
const hi = {
  bolt:    '<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8Z"/>',
  lock:    '<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
  users:   '<circle cx="9" cy="8" r="3.2"/><path d="M3.5 20a5.5 5.5 0 0 1 11 0"/><path d="M16 5.2a3.2 3.2 0 0 1 0 5.6M17.5 20a5.5 5.5 0 0 0-3-4.9"/>',
  file:    '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/><path d="M8 13h8M8 17h5"/>',
  chart:   '<path d="M3 3v18h18"/><rect x="7" y="10" width="3" height="7" rx="1"/><rect x="12.5" y="6" width="3" height="11" rx="1"/><rect x="18" y="13" width="3" height="4" rx="1"/>',
  convert: '<path d="M7 8h11l-3-3M17 16H6l3 3"/>',
  grid:    '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M3 15h18M9 3v18M15 3v18"/>',
  ai:      '<path d="M12 2c.5 4.6 2.8 6.9 7.4 7.4C14.8 9.9 12.5 12.2 12 16.8 11.5 12.2 9.2 9.9 4.6 9.4 9.2 8.9 11.5 6.6 12 2Z"/>',
  cap:     '<path d="M22 10 12 5 2 10l10 5 10-5Z"/><path d="M6 12v5c0 1 2.7 2.5 6 2.5s6-1.5 6-2.5v-5"/>',
  case:    '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 13h18"/>',
  building:'<path d="M4 21V5a1 1 0 0 1 1-1h9a1 1 0 0 1 1 1v16"/><path d="M15 9h4a1 1 0 0 1 1 1v11M2 21h20M8 8h.01M8 12h.01M8 16h.01M11 8h.01M11 12h.01M11 16h.01"/>',
  shield:  '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/>',
  gear:    '<circle cx="12" cy="12" r="3.2"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-2.9 1.2V21a2 2 0 0 1-4 0v-.1A1.7 1.7 0 0 0 7 19.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0-1.2-2.9H3a2 2 0 0 1 0-4h.1A1.7 1.7 0 0 0 4.7 7l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3H9.4A1.7 1.7 0 0 0 10.6 3V3a2 2 0 0 1 4 0v.1A1.7 1.7 0 0 0 17 4.7l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9v.1a1.7 1.7 0 0 0 1.5 1h.1a2 2 0 0 1 0 4H21a1.7 1.7 0 0 0-1.6 1Z"/>',
  arrow:   '<path d="M5 12h14M13 6l6 6-6 6"/>',
  dots:    '<circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/>',
};
function ic(name) {
  return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + (hi[name] || hi.file) + '</svg>';
}

const capabilities = [
  { icon: 'file',    tint: 'rose',   title: 'PDF tools',       desc: 'Edit, organize, merge, split, compress, add text and images, and export to other formats.' },
  { icon: 'file',    tint: 'blue',   title: 'Document editor', desc: 'Create and edit professional documents with rich formatting, templates and real-time tools.' },
  { icon: 'chart',   tint: 'green',  title: 'Charts & graphs', desc: 'Turn your data into editable tables, charts and visual content.' },
  { icon: 'convert', tint: 'violet', title: 'Convert & export', desc: 'Convert between PDF, Word, Excel, PowerPoint, HTML and image formats.' },
  { icon: 'grid',    tint: 'amber',  title: 'Spreadsheets',    desc: 'Spreadsheet tools are currently under development.' },
  { icon: 'ai',      tint: 'indigo', title: 'AI features',     desc: 'Smart tools to summarize, rewrite and improve your documents (preview).' },
];

const audience = [
  { icon: 'cap',      title: 'Students',      desc: 'Class notes, assignments and projects.' },
  { icon: 'case',     title: 'Professionals', desc: 'Reports, proposals and presentations.' },
  { icon: 'building', title: 'Businesses',    desc: 'Documents, invoices and everyday operations.' },
  { icon: 'users',    title: 'Everyone',      desc: 'Quick and reliable document tasks.' },
];

const commitments = [
  { icon: 'shield', title: 'Your files, your control', desc: 'Files are processed in your browser and never uploaded to our servers.' },
  { icon: 'gear',   title: 'Simple by design',         desc: 'A clean, intuitive experience focused on your productivity.' },
  { icon: 'chart',  title: 'Always improving',         desc: 'New features and tools based on your feedback.' },
];

const formats = [
  { key: 'pdf', label: 'PDF',        letter: 'PDF' },
  { key: 'word', label: 'Word',      letter: 'W' },
  { key: 'excel', label: 'Excel',    letter: 'X' },
  { key: 'ppt', label: 'PowerPoint', letter: 'P' },
  { key: 'img', label: 'Images',     icon: true },
  { key: 'more', label: 'More',      more: true },
];
%>

<!-- ============ HERO ============ -->
<section class="ab-hero">
  <div class="ab-hero__aura" aria-hidden="true"></div>
  <div class="container ab-hero__inner">
    <div class="ab-hero__copy">
      <span class="kicker">About <%= site.name %></span>
      <h1 class="ab-hero__title">Modern document tools.<br>Built for a more <span class="grad">productive you.</span></h1>
      <p class="ab-hero__sub">
        <%= site.name %> is a secure, browser-based workspace for editing,
        converting and managing documents — simple, powerful and accessible
        from anywhere.
      </p>
      <ul class="ab-usp">
        <li>
          <span class="ab-usp__ico"><%- ic('bolt') %></span>
          <span><strong>Fast</strong><small>Get things done in seconds</small></span>
        </li>
        <li>
          <span class="ab-usp__ico"><%- ic('lock') %></span>
          <span><strong>Private</strong><small>Your files stay on your device</small></span>
        </li>
        <li>
          <span class="ab-usp__ico"><%- ic('users') %></span>
          <span><strong>Accessible</strong><small>Designed for individuals, teams and businesses</small></span>
        </li>
      </ul>
    </div>

    <div class="ab-hero__visual" aria-hidden="true">
      <div class="ab-mock">
        <div class="ab-mock__bar"><span class="ab-mock__traffic"><i></i><i></i><i></i></span><span class="ab-mock__title">Advance Office Doc</span></div>
        <div class="ab-mock__body">
          <aside class="ab-mock__rail"><i></i><i></i><i></i><i></i><i></i><i></i></aside>
          <div class="ab-mock__page">
            <h3>Create<br>Edit<br>Convert<br><span class="grad">All in One</span></h3>
            <span class="ab-mock__line"></span>
            <span class="ab-mock__line short"></span>
          </div>
          <aside class="ab-mock__rail ab-mock__rail--r"><i></i><i></i><i></i><i></i></aside>
        </div>
      </div>
      <ul class="ab-formats">
        <% formats.forEach(function (f) { %>
          <li class="ab-fmt ab-fmt--<%= f.key %>">
            <span class="ab-fmt__ico"><% if (f.more) { %><%- ic('dots') %><% } else if (f.icon) { %><%- ic('file') %><% } else { %><%= f.letter %><% } %></span>
            <%= f.label %>
          </li>
        <% }); %>
      </ul>
      <span class="ab-note">Your Documents,<br>Your Control</span>
    </div>
  </div>
</section>

<!-- ============ STATS ============ -->
<section class="ab-statsec">
  <div class="container">
    <ul class="ab-stats">
      <li><span class="ab-stats__num grad">10+</span><span class="ab-stats__lbl">Powerful tools</span></li>
      <li><span class="ab-stats__num grad">100%</span><span class="ab-stats__lbl">Browser based</span></li>
      <li><span class="ab-stats__num grad">0</span><span class="ab-stats__lbl">Installation required</span></li>
      <li><span class="ab-stats__num grad">∞</span><span class="ab-stats__lbl">Built for everyone</span></li>
    </ul>
  </div>
</section>

<!-- ============ OUR STORY ============ -->
<section class="ab-sec">
  <div class="container ab-story">
    <div class="ab-story__copy">
      <span class="kicker">Our story</span>
      <h2 class="ab-h2">A simpler way to work with documents</h2>
      <p>We believe document work should be effortless. Too often, people have to juggle multiple apps, deal with complicated software or upload sensitive files to unknown servers.</p>
      <p><%= site.name %> was created to change that — bringing essential document tools into one clean, secure and easy-to-use workspace that works directly in your browser.</p>
    </div>
    <figure class="ab-quote">
      <span class="ab-quote__mark">&ldquo;</span>
      <blockquote>Our mission is to empower everyone to work with documents effortlessly, securely and from anywhere.</blockquote>
      <figcaption>— <%= site.name %></figcaption>
    </figure>
  </div>
</section>

<!-- ============ WHAT YOU CAN DO ============ -->
<section class="ab-sec">
  <div class="container">
    <span class="kicker">What you can do</span>
    <h2 class="ab-h2 ab-h2--lead">Everything you need in one workspace</h2>
    <div class="ab-cards">
      <% capabilities.forEach(function (c) { %>
        <article class="ab-card">
          <span class="ab-card__ico tint-<%= c.tint %>"><%- ic(c.icon) %></span>
          <div>
            <h3><%= c.title %></h3>
            <p><%= c.desc %></p>
          </div>
        </article>
      <% }); %>
    </div>
  </div>
</section>

<!-- ============ WHO IT'S FOR ============ -->
<section class="ab-sec">
  <div class="container">
    <span class="kicker">Who it's for</span>
    <h2 class="ab-h2 ab-h2--lead">Built for modern work</h2>
    <ul class="ab-audience">
      <% audience.forEach(function (a) { %>
        <li>
          <span class="ab-mini-ico"><%- ic(a.icon) %></span>
          <span><strong><%= a.title %></strong><small><%= a.desc %></small></span>
        </li>
      <% }); %>
    </ul>
  </div>
</section>

<!-- ============ OUR COMMITMENT ============ -->
<section class="ab-sec">
  <div class="container">
    <span class="kicker">Our commitment</span>
    <h2 class="ab-h2 ab-h2--lead">Designed with privacy in mind</h2>
    <ul class="ab-commit">
      <% commitments.forEach(function (c) { %>
        <li>
          <span class="ab-mini-ico"><%- ic(c.icon) %></span>
          <span><strong><%= c.title %></strong><small><%= c.desc %></small></span>
        </li>
      <% }); %>
    </ul>
  </div>
</section>

<!-- ============ CTA ============ -->
<section class="ab-sec ab-ctasec">
  <div class="container">
    <div class="ab-cta">
      <div class="ab-cta__aura" aria-hidden="true"></div>
      <div class="ab-cta__copy">
        <span class="kicker">Ready to get started?</span>
        <h2>Your documents, <span class="grad">your way.</span></h2>
        <p>Create, edit and manage documents in one powerful workspace.</p>
      </div>
      <div class="ab-cta__actions">
        <a href="/workspace" class="btn btn-purple btn-lg">Open editor <%- ic('arrow') %></a>
        <a href="/tools" class="btn btn-glass btn-lg">Explore tools</a>
      </div>
    </div>
  </div>
</section>
