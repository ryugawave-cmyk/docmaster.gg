<section class="hero hero--video">
  <!-- Full-bleed decorative particle video BEHIND the whole hero (text included).
       autoplay/muted/loop/playsInline, no controls, no audio, pointer-events none.
       Replaceable at /media/hero-particles.{webm,mp4}; a dark gradient + poster is
       the fallback (also shown under prefers-reduced-motion). A scrim keeps text
       readable over the video. -->
  <div class="hero__bg" aria-hidden="true">
    <video class="hero__video" autoplay muted loop playsinline preload="auto" tabindex="-1"
           poster="/media/hero-particles-poster.svg">
      <source src="/media/hero-particles.mp4" type="video/mp4" />
    </video>
    <div class="hero__scrim"></div>
  </div>
  <div class="container hero-inner">
    <div class="hero-content">
      <span class="eyebrow">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
        All-in-one document workspace
      </span>
      <h1 class="hero-title">
        Edit PDFs, Documents and
        <span class="text-gradient">Spreadsheets</span>
        in One Place
      </h1>
      <p class="hero-subtitle">
        Create, edit, convert and export documents directly in your browser.
        No software installation, no uploads required, and complete control
        over your files.
      </p>
      <div class="hero-actions">
        <a href="/workspace" class="btn btn-primary btn-lg">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
          Open Editor
          <svg class="icon hero-actions__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href="/tools" class="btn btn-outline btn-lg">View Tools</a>
      </div>
      <ul class="hero-features">
        <li class="hero-feature">
          <span class="hero-feature__icon"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="M9 12l2 2 4-4"/></svg></span>
          <span class="hero-feature__text"><strong>Secure &amp; Private</strong><small>No uploads required</small></span>
        </li>
        <li class="hero-feature">
          <span class="hero-feature__icon"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2 3 14h9l-1 8 10-12h-9z"/></svg></span>
          <span class="hero-feature__text"><strong>Works in Browser</strong><small>No installation</small></span>
        </li>
        <li class="hero-feature">
          <span class="hero-feature__icon"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg></span>
          <span class="hero-feature__text"><strong>All-in-One</strong><small>PDF, Doc, Excel &amp; more</small></span>
        </li>
        <li class="hero-feature">
          <span class="hero-feature__icon"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
          <span class="hero-feature__text"><strong>Free to Use</strong><small>Get started instantly</small></span>
        </li>
      </ul>
    </div>

    <div class="hero-visual" aria-hidden="true">
      <div class="hero-app">
        <div class="hero-app__bar">
          <div class="hero-app__brand">
            <img src="/images/logo-mark.png" alt="" width="22" height="22" />
            <span>Advance Office Doc</span>
          </div>
          <div class="hero-app__menu"><span>File</span><span>Edit</span><span>Insert</span><span>Format</span><span>Tools</span><span>Help</span></div>
          <div class="hero-app__tools">
            <span class="hero-app__zoom">100% ▾</span>
            <span class="hero-app__export">Export ▾</span>
          </div>
        </div>
        <div class="hero-app__body">
          <aside class="hero-app__side">
            <span class="hero-app__nav is-active"><%- include('../partials/icon', { name: 'edit' }) %> PDF Editor</span>
            <span class="hero-app__nav"><%- include('../partials/icon', { name: 'edit' }) %> Document Editor</span>
            <span class="hero-app__nav"><%- include('../partials/icon', { name: 'organize' }) %> Spreadsheet</span>
            <span class="hero-app__nav"><%- include('../partials/icon', { name: 'convert' }) %> Convert Files</span>
            <span class="hero-app__nav"><%- include('../partials/icon', { name: 'organize' }) %> Organize PDF</span>
            <span class="hero-app__nav"><%- include('../partials/icon', { name: 'sign' }) %> Sign PDF</span>
            <span class="hero-app__nav"><%- include('../partials/icon', { name: 'ai' }) %> AI Tools</span>
            <span class="hero-app__nav"><%- include('../partials/icon', { name: 'organize' }) %> More Tools</span>
          </aside>
          <div class="hero-app__doc">
            <h3>Project Proposal</h3>
            <p>This document outlines the project goals, scope, timeline and key deliverables for the upcoming phase.</p>
            <div class="hero-app__cols">
              <span class="hero-app__img"></span>
              <span class="hero-app__lines">
                <i></i><i></i><i class="accent"></i><i></i>
              </span>
            </div>
            <h4>Key Objectives</h4>
            <ul class="hero-app__obj">
              <li>Improve productivity and collaboration</li>
              <li>Streamline document workflow</li>
              <li>Deliver high-quality results</li>
            </ul>
            <div class="hero-app__charts">
              <span class="hero-app__pie"></span>
              <span class="hero-app__bars"><i></i><i></i><i></i><i></i><i></i></span>
            </div>
          </div>
          <div class="hero-app__files">
            <span class="hero-file hero-file--pdf">PDF</span>
            <span class="hero-file hero-file--w">W</span>
            <span class="hero-file hero-file--x">X</span>
            <span class="hero-file hero-file--p">P</span>
            <span class="hero-file hero-file--img"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-5-5L5 21"/></svg></span>
            <span class="hero-file hero-file--conv"><%- include('../partials/icon', { name: 'convert' }) %></span>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="hero-glow" aria-hidden="true"></div>
</section>

<!-- ============ What Advance Office Doc does ============ -->
<section class="section" id="overview">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow eyebrow--center">One workspace</span>
      <h2 class="section-title">Every document job, in one private place</h2>
      <p class="section-lead">
        <%= site.name %> brings the everyday tools you reach for — PDFs, documents, charts and
        conversions — into a single browser-based workspace. There’s nothing to install, no account
        to create, and your files are processed on your own device.
      </p>
    </div>
    <div class="features-grid">
      <div class="feature" style="--accent: #6366f1;">
        <span class="feature__icon" aria-hidden="true"><%- include('../partials/icon', { name: 'merge' }) %></span>
        <h3>PDF tools</h3>
        <p>Merge, split, compress, organize, edit and sign PDFs — reorder pages, add text and images, then export a finished file.</p>
      </div>
      <div class="feature" style="--accent: #f59e0b;">
        <span class="feature__icon" aria-hidden="true"><%- include('../partials/icon', { name: 'edit' }) %></span>
        <h3>Document editor</h3>
        <p>Write letters, reports and notes in a clean, Docs-style editor with headings, tables, images, headers and footers.</p>
      </div>
      <div class="feature" style="--accent: #10b981;">
        <span class="feature__icon" aria-hidden="true"><%- include('../partials/icon', { name: 'organize' }) %></span>
        <h3>Charts &amp; graphs</h3>
        <p>Turn your data into editable bar, line and pie charts and place them straight into a document.</p>
      </div>
      <div class="feature" style="--accent: #0ea5e9;">
        <span class="feature__icon" aria-hidden="true"><%- include('../partials/icon', { name: 'convert' }) %></span>
        <h3>Convert &amp; export</h3>
        <p>Move between PDF, Word, HTML and image formats, and export tables to Excel for further analysis.</p>
      </div>
    </div>
  </div>
</section>

<!-- ============ Tools grid ============ -->
<section class="section section--alt" id="tools">
  <div class="container">
    <div class="section-head">
      <h2 class="section-title">Popular tools</h2>
      <p class="section-lead">Pick a tool to learn how it works, then open it in the editor.</p>
    </div>
    <div class="tools-grid">
      <% tools.forEach(function (tool) { %>
        <%- include('../partials/tool-card', { tool: tool }) %>
      <% }); %>
    </div>
    <div class="section-foot">
      <a href="/tools" class="btn btn-outline btn-lg">Browse all tools</a>
    </div>
  </div>
</section>

<!-- ============ How it works ============ -->
<section class="section" id="how-it-works">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow eyebrow--center">How it works</span>
      <h2 class="section-title">Three steps, no uploads</h2>
      <p class="section-lead">Because processing happens in your browser, getting started is fast and private.</p>
    </div>
    <ol class="home-steps">
      <li style="--accent: #6366f1;">
        <span class="steps__icon" aria-hidden="true">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M12 18v-6M9.5 15.5 12 18l2.5-2.5"/></svg>
          <span class="steps__num">1</span>
        </span>
        <h3>Open your file</h3>
        <p>Choose a tool and open a document from your device. It’s loaded straight into your browser — not sent to a server.</p>
      </li>
      <li style="--accent: #8b5cf6;">
        <span class="steps__icon" aria-hidden="true">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
          <span class="steps__num">2</span>
        </span>
        <h3>Make your changes</h3>
        <p>Merge, edit, convert, sign, write or chart. Everything updates live in the editor as you work.</p>
      </li>
      <li style="--accent: #10b981;">
        <span class="steps__icon" aria-hidden="true">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>
          <span class="steps__num">3</span>
        </span>
        <h3>Export and save</h3>
        <p>Download the finished file directly to your device in the format you need. Nothing is stored by us.</p>
      </li>
    </ol>
  </div>
</section>

<!-- ============ Privacy band ============ -->
<section class="section section--alt" id="privacy">
  <div class="container">
    <div class="privacy-band">
      <div class="privacy-band__text">
        <span class="eyebrow">Privacy by design</span>
        <h2 class="section-title">Your files never leave your device</h2>
        <p>
          <%= site.name %> is a client-side application: your documents are opened and processed
          locally in your browser and are not uploaded to our servers. There’s no account to create
          and no document database on our side. It’s privacy built into how the product works, not a
          promise bolted on afterwards.
        </p>
        <div class="privacy-band__actions">
          <a href="/security" class="btn btn-primary">How we keep you safe</a>
          <a href="/privacy" class="btn btn-outline">Read the Privacy Policy</a>
        </div>
      </div>
      <ul class="privacy-band__list">
        <li>Processed in your browser — no file uploads</li>
        <li>No account required</li>
        <li>No third-party trackers by default</li>
        <li>Served over HTTPS with a strict security policy</li>
      </ul>
    </div>
  </div>
</section>

<!-- ============ FAQ ============ -->
<section class="section" id="faq">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow eyebrow--center">FAQ</span>
      <h2 class="section-title">Frequently asked questions</h2>
    </div>
    <div class="faq faq--home">
      <details class="faq__item">
        <summary>Is <%= site.name %> free to use?</summary>
        <p>Yes. Every tool available today is free while the platform is in active development. See our <a href="/pricing">Pricing page</a> for what’s planned next.</p>
      </details>
      <details class="faq__item">
        <summary>Do I need to create an account?</summary>
        <p>No. You can use the tools straight away without signing up.</p>
      </details>
      <details class="faq__item">
        <summary>Are my files uploaded to your servers?</summary>
        <p>No. Your files are processed in your browser, on your device. We never receive, view or store their contents. Read more on our <a href="/security">Security page</a>.</p>
      </details>
      <details class="faq__item">
        <summary>What file types can I work with?</summary>
        <p>You can work with PDFs and images, create documents from scratch, and export to formats like PDF, Word (.docx), HTML and Excel (.xlsx). Each <a href="/tools">tool page</a> lists what it supports.</p>
      </details>
      <details class="faq__item">
        <summary>Does it work on mobile?</summary>
        <p>Yes, the tools run in modern mobile browsers. Very large files and heavier tasks are more comfortable on a laptop or desktop, where there’s more memory available.</p>
      </details>
      <details class="faq__item">
        <summary>Can I convert a PDF to Word or Excel?</summary>
        <p>Yes. Use the <a href="/tools/convert-pdf">Convert</a> tools to export to Word, HTML and images, or export tables to Excel — all generated locally in your browser.</p>
      </details>
    </div>
  </div>
</section>
