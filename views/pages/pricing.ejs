<section class="page-hero">
  <div class="container">
    <span class="eyebrow eyebrow--center">Pricing</span>
    <h1 class="page-hero__title">Free to use today</h1>
    <p class="page-hero__lead">
      Every tool on <%= site.name %> is currently free while the platform is in active development.
      Paid plans below are planned for the future — they are not available yet.
    </p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="pricing-grid">
      <article class="price-card price-card--featured">
        <div class="price-card__badge">Available now</div>
        <h2 class="price-card__name">Free</h2>
        <p class="price-card__price"><span>$0</span></p>
        <p class="price-card__desc">Everything the platform offers today.</p>
        <ul class="price-card__features">
          <li>All current PDF tools</li>
          <li>Document editor with tables, images and charts</li>
          <li>Convert &amp; export (PDF, Word, HTML, Excel, images)</li>
          <li>Files processed privately in your browser</li>
          <li>No account required</li>
        </ul>
        <a href="/workspace" class="btn btn-primary btn-block">Open the editor</a>
      </article>

      <article class="price-card">
        <div class="price-card__badge price-card__badge--soon">Planned</div>
        <h2 class="price-card__name">Pro</h2>
        <p class="price-card__price price-card__price--soon"><span>Coming soon</span></p>
        <p class="price-card__desc">Ideas we’re exploring for power users.</p>
        <ul class="price-card__features">
          <li>Larger and batch processing</li>
          <li>Expanded on-device tools</li>
          <li>Priority support</li>
        </ul>
        <a href="/contact" class="btn btn-outline btn-block">Get notified</a>
      </article>

      <article class="price-card">
        <div class="price-card__badge price-card__badge--soon">Planned</div>
        <h2 class="price-card__name">Team</h2>
        <p class="price-card__price price-card__price--soon"><span>Coming soon</span></p>
        <p class="price-card__desc">For groups who work together.</p>
        <ul class="price-card__features">
          <li>Everything planned for Pro</li>
          <li>Shared workflows</li>
          <li>Admin options</li>
        </ul>
        <a href="/contact" class="btn btn-outline btn-block">Contact us</a>
      </article>
    </div>

    <p class="pricing-note">
      Pricing and Pro/Team features are indicative and not yet available. Have a suggestion?
      <a href="/contact">Tell us what you’d find useful.</a>
    </p>
  </div>
</section>
