<%
// ============================================================
//  Contact — premium dark layout (matches the design ref).
//  Styling: public/css/contact.css (loaded only on "/contact").
//  IMPORTANT: the form keeps every hook main.js relies on —
//  [data-contact-form], [data-contact-email], field names
//  name/email/reason/message/company, and [data-form-note].
// ============================================================
const hi = {
  chat:  '<path d="M21 15a2 2 0 0 1-2 2H8l-4 4V6a2 2 0 0 1 2-2h13a2 2 0 0 1 2 2Z"/><path d="M8.5 10h7M8.5 13h4"/>',
  bug:   '<path d="M8 6a4 4 0 0 1 8 0M6 10h12M5 14h14"/><rect x="8" y="6" width="8" height="12" rx="4"/><path d="M12 6v12M4 9l2 1M20 9l-2 1M3 16l3-1M21 16l-3-1M6 20l2-2M18 20l-2-2"/>',
  bulb:  '<path d="M9 18h6M10 21h4"/><path d="M12 3a6 6 0 0 0-4 10.5c.7.8 1 1.4 1 2.5h6c0-1.1.3-1.7 1-2.5A6 6 0 0 0 12 3Z"/>',
  mail:  '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  doc:   '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/><path d="M8 13h8M8 17h5"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  user:  '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
  tag:   '<path d="M20.6 13.4 12 22l-9-9V4a1 1 0 0 1 1-1h9Z"/><circle cx="8" cy="8" r="1.4"/>',
  send:  '<path d="M22 2 11 13M22 2l-7 20-4-9-9-4Z"/>',
  lock:  '<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
};
function ic(name) {
  return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + (hi[name] || hi.chat) + '</svg>';
}
%>

<section class="cx">
  <div class="cx__orbs" aria-hidden="true">
    <span class="cx__orb cx__orb--1"></span>
    <span class="cx__orb cx__orb--2"></span>
    <span class="cx__orb cx__orb--3"></span>
    <span class="cx__orb cx__orb--4"></span>
  </div>
  <span class="cx__side cx__side--tr" aria-hidden="true">Let's build a<br>better document experience<br>together</span>
  <span class="cx__side cx__side--br" aria-hidden="true">Simple<br>Secure<br>Productive<br>Together</span>

  <div class="container cx__grid">
    <!-- ===== Left ===== -->
    <div class="cx__intro">
      <span class="cx__badge">Contact Us</span>
      <h1 class="cx__title">We'd love<br>to <span class="grad">hear from you</span></h1>
      <p class="cx__sub">
        Have a question, feedback or found a bug? Our team is here to help.
        Send us a message and we'll get back to you as soon as possible.
      </p>

      <div class="cx__reasons">
        <div class="cx-reason">
          <span class="cx-reason__ico"><%- ic('chat') %></span>
          <strong>General Questions</strong>
          <small>Ask about our tools, features or plans.</small>
        </div>
        <div class="cx-reason">
          <span class="cx-reason__ico"><%- ic('bug') %></span>
          <strong>Report an Issue</strong>
          <small>Found a bug? Let us know.</small>
        </div>
        <div class="cx-reason">
          <span class="cx-reason__ico"><%- ic('bulb') %></span>
          <strong>Share Feedback</strong>
          <small>Your ideas help us improve.</small>
        </div>
      </div>

      <ul class="cx__facts">
        <li class="cx-fact">
          <span class="cx-fact__ico"><%- ic('mail') %></span>
          <span class="cx-fact__body">
            <strong>Email us</strong>
            <a href="mailto:<%= site.contactEmail %>"><%= site.contactEmail %></a>
            <small>We read every message.</small>
          </span>
        </li>
        <li class="cx-fact">
          <span class="cx-fact__ico"><%- ic('clock') %></span>
          <span class="cx-fact__body">
            <strong>Response time</strong>
            <small>We usually reply within 1–2 business days.</small>
          </span>
        </li>
        <li class="cx-fact">
          <span class="cx-fact__ico"><%- ic('doc') %></span>
          <span class="cx-fact__body">
            <strong>Helpful resources</strong>
            <small>Check our <a href="/tools">Tools</a> pages and <a href="/privacy">Privacy Policy</a> for answers to common questions.</small>
          </span>
          <a href="/tools" class="cx-fact__go" aria-label="Browse tools"><%- ic('arrow') %></a>
        </li>
      </ul>

      <span class="cx__note" aria-hidden="true">Ideas<br>Feedback<br>Support<br>Always welcome!</span>
    </div>

    <!-- ===== Right: form ===== -->
    <form class="cx-form" data-contact-form data-contact-email="<%= contactTo %>" novalidate>
      <div class="cx-form__head">
        <span class="cx-form__ico"><%- ic('chat') %></span>
        <div>
          <h2>Send us a message</h2>
          <p>Fill out the form below and we'll get back to you soon.</p>
        </div>
      </div>

      <%# Honeypot: hidden from people, tempting to bots. %>
      <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true"
        style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />

      <div class="cx-form__row">
        <div class="cx-field">
          <label for="name">Name <span class="req">*</span></label>
          <span class="cx-input">
            <span class="cx-input__ico"><%- ic('user') %></span>
            <input type="text" id="name" name="name" placeholder="Your name" autocomplete="name" required />
          </span>
        </div>
        <div class="cx-field">
          <label for="email">Email <span class="req">*</span></label>
          <span class="cx-input">
            <span class="cx-input__ico"><%- ic('mail') %></span>
            <input type="email" id="email" name="email" placeholder="you@example.com" autocomplete="email" required />
          </span>
        </div>
      </div>

      <div class="cx-field">
        <label for="reason">Reason for contacting <span class="req">*</span></label>
        <span class="cx-input cx-input--select">
          <span class="cx-input__ico"><%- ic('tag') %></span>
          <select id="reason" name="reason">
            <option value="" disabled selected>Select a reason</option>
            <option value="General question">General question</option>
            <option value="Bug report">Bug report</option>
            <option value="Feature request">Feature request</option>
            <option value="Privacy question">Privacy question</option>
            <option value="Business / partnership">Business / partnership</option>
            <option value="Other">Other</option>
          </select>
          <span class="cx-input__chev" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </span>
        </span>
      </div>

      <div class="cx-field">
        <label for="message">Message <span class="req">*</span></label>
        <span class="cx-input cx-input--area">
          <span class="cx-input__ico"><%- ic('doc') %></span>
          <textarea id="message" name="message" rows="5" maxlength="1000" placeholder="How can we help?" required></textarea>
        </span>
        <span class="cx-count"><span data-char-count>0</span>/1000</span>
      </div>

      <button type="submit" class="cx-submit">
        <span class="cx-submit__ico"><%- ic('send') %></span> Send message
      </button>

      <p class="cx-form__privacy">
        <span class="cx-form__lock"><%- ic('lock') %></span>
        We only use your information to respond to your inquiry.
        Read our <a href="/privacy">Privacy Policy</a>.
      </p>
      <p class="form-note cx-note" data-form-note role="status" aria-live="polite" hidden></p>
    </form>
  </div>
</section>
