<section class="page-hero">
  <div class="container">
    <span class="eyebrow eyebrow--center">Contact</span>
    <h1 class="page-hero__title">Get in touch</h1>
    <p class="page-hero__lead">
      Questions, feedback or a bug to report? Email is the best way to reach us and we’ll get back
      to you as soon as we can.
    </p>
  </div>
</section>

<section class="section">
  <div class="container contact-layout">
    <div class="contact-info">
      <h2>Contact details</h2>
      <p>
        We’re a small team, so email is our primary support channel. Reach out any time — we read
        every message.
      </p>
      <ul class="contact-list">
        <li>
          <span class="contact-list__label">General &amp; support</span>
          <a href="mailto:bloodpath9089@gmail.com">bloodpath9089@gmail.com</a>
        </li>
        <li>
          <span class="contact-list__label">Response time</span>
          <span>We aim to reply within a few business days.</span>
        </li>
      </ul>

      <div class="contact-help">
        <h3>Before you write</h3>
        <p>
          Many questions are answered on our <a href="/tools">Tools</a> pages and in the
          <a href="/privacy">Privacy Policy</a>. If you’re reporting a problem, letting us know your
          browser and what you were trying to do helps us fix it faster.
        </p>
      </div>
    </div>

    <form class="contact-form" data-contact-form data-contact-email="<%= site.contactEmail %>" novalidate>
      <p class="contact-form__intro">
        This form opens your email app with your message pre-filled, addressed to our support inbox.
      </p>
      <div class="form-row">
        <div class="form-field">
          <label for="name">Name</label>
          <input type="text" id="name" name="name" placeholder="Your name" autocomplete="name" required />
        </div>
        <div class="form-field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" placeholder="you@example.com" autocomplete="email" required />
        </div>
      </div>
      <div class="form-field">
        <label for="reason">Reason for contacting</label>
        <select id="reason" name="reason">
          <option value="General question">General question</option>
          <option value="Bug report">Bug report</option>
          <option value="Feature request">Feature request</option>
          <option value="Privacy question">Privacy question</option>
          <option value="Business / partnership">Business / partnership</option>
          <option value="Other">Other</option>
        </select>
      </div>
      <div class="form-field">
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="5" placeholder="How can we help?" required></textarea>
      </div>
      <button type="submit" class="btn btn-primary btn-lg">Compose email</button>
      <p class="form-note" data-form-note role="status" aria-live="polite" hidden>
        Opening your email app… If nothing happens, email us directly at
        <a href="mailto:<%= site.contactEmail %>"><%= site.contactEmail %></a>.
      </p>
    </form>
  </div>
</section>
