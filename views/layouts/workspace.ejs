<!DOCTYPE html>
<html lang="en" class="ws-html">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#0f1020" />

  <!-- Google Analytics 4 — loaded on the workspace SPA too (same tag, once). -->
  <%- include('../partials/analytics') %>

  <title><%= pageTitle %> · <%= site.name %></title>
  <meta name="description" content="<%= metaDescription %>" />
  <meta name="robots" content="<%= (typeof robots !== 'undefined' && robots) ? robots : 'noindex, nofollow' %>" />

  <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />

  <!-- Fonts are self-hosted (see public/css/fonts.css) so the app can enable
       cross-origin isolation (COOP/COEP) without a cross-origin subresource. -->
  <link rel="stylesheet" href="/css/fonts.css?v=<%= assetVersion %>" />

  <link rel="stylesheet" href="/css/workspace.css?v=<%= assetVersion %>" />
  <link rel="stylesheet" href="/css/app.css?v=<%= assetVersion %>" />
  <link rel="stylesheet" href="/css/blank-editor.css?v=<%= assetVersion %>" />
  <!-- Auth gate styling (full-screen sign-in panel; reuses the modal button). -->
  <link rel="stylesheet" href="/css/auth.css?v=<%= assetVersion %>" />
  <%- style %>
</head>
<body class="ws-body">
  <%- body %>

  <!-- Editor auth gate. The app module is NOT loaded here directly — the gate
       loads it only once a Supabase session is confirmed, so the editor is
       inaccessible without signing in. `defer` preserves order so
       window.supabase exists before the gate runs. Only the ESM entry carries
       ?v=; its relative imports resolve unversioned and stay on revalidate
       caching, so a deploy can never serve a stale module graph. -->
  <script src="/vendor/supabase/supabase.js?v=<%= assetVersion %>" defer></script>
  <script nonce="<%= nonce %>">window.__APP_MODULE = "/js/app/index.js?v=<%= assetVersion %>";</script>
  <script src="/js/workspace-gate.js?v=<%= assetVersion %>" defer></script>
  <%- script %>
</body>
</html>
