<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <%- style %>
</head>
<body class="<%= currentPath === '/' ? 'page-home' : (currentPath === '/tools' ? 'page-tools' : (currentPath === '/pricing' ? 'page-pricing' : (currentPath === '/about' ? 'page-about' : (currentPath === '/contact' ? 'page-contact' : '')))) %>">
  <a class="skip-link" href="#main">Skip to content</a>

  <%- include('../partials/header') %>

  <main id="main">
    <%- body %>
  </main>

  <%- include('../partials/footer') %>

  <% if (features && features.cookieConsent) { %>
    <%- include('../partials/cookie-consent') %>
  <% } %>

  <script src="/js/main.js?v=<%= assetVersion %>" defer></script>
  <!-- Google sign-in: Supabase client (vendored same-origin) then our auth glue.
       `defer` preserves order so window.supabase exists before auth.js runs. -->
  <script src="/vendor/supabase/supabase.js?v=<%= assetVersion %>" defer></script>
  <script src="/js/auth.js?v=<%= assetVersion %>" defer></script>
  <% if (features && features.cookieConsent) { %>
    <script src="/js/consent.js?v=<%= assetVersion %>" defer></script>
  <% } %>
  <%- script %>
</body>
</html>
