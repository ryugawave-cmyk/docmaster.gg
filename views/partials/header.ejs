<header class="site-header" data-header>
  <div class="container header-inner">
    <%- include('./brand') %>

    <button class="nav-toggle" data-nav-toggle aria-expanded="false" aria-controls="primary-nav" aria-label="Toggle navigation">
      <span></span><span></span><span></span>
    </button>

    <nav class="primary-nav" id="primary-nav" data-nav aria-label="Primary">
      <ul class="nav-list">
        <% navigation.forEach(function (item) { %>
          <%
            const isActive = item.match === 'prefix'
              ? currentPath.startsWith(item.href)
              : currentPath === item.href;
          %>
          <li>
            <a href="<%= item.href %>" class="nav-link <%= isActive ? 'is-active' : '' %>"<%- isActive ? ' aria-current="page"' : '' %>><%= item.label %></a>
          </li>
        <% }); %>
      </ul>
      <div class="nav-actions">
        <a href="/tools" class="btn btn-ghost">Explore tools</a>
        <a href="/workspace" class="btn btn-primary">Open editor</a>
        <!-- Auth: server renders the "Sign in" button; auth.js swaps it for a
             user chip when a Google session exists (see public/js/auth.js). -->
        <div class="auth-area" data-auth>
          <button class="btn btn-outline auth-btn" type="button" data-auth-signin>
            <svg class="auth-g" viewBox="0 0 18 18" width="18" height="18" aria-hidden="true">
              <path fill="#4285F4" d="M17.64 9.2c0-.64-.06-1.25-.16-1.84H9v3.48h4.84a4.14 4.14 0 0 1-1.8 2.72v2.26h2.92c1.7-1.57 2.68-3.88 2.68-6.62z"/>
              <path fill="#34A853" d="M9 18c2.43 0 4.47-.8 5.96-2.18l-2.92-2.26c-.81.54-1.85.86-3.04.86-2.34 0-4.32-1.58-5.03-3.7H.96v2.33A9 9 0 0 0 9 18z"/>
              <path fill="#FBBC05" d="M3.97 10.72a5.4 5.4 0 0 1 0-3.44V4.95H.96a9 9 0 0 0 0 8.1l3.01-2.33z"/>
              <path fill="#EA4335" d="M9 3.58c1.32 0 2.5.45 3.44 1.35l2.58-2.58C13.47.89 11.43 0 9 0A9 9 0 0 0 .96 4.95l3.01 2.33C4.68 5.16 6.66 3.58 9 3.58z"/>
            </svg>
            <span>Sign in</span>
          </button>
        </div>
      </div>
    </nav>
  </div>
</header>
