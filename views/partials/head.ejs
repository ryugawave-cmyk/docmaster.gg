<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="theme-color" content="#6366f1" />

<!-- Google Analytics 4 — loaded first in <head> on every page/route. -->
<%- include('./analytics') %>

<%
  const fullTitle = (typeof pageTitle !== 'undefined' && pageTitle)
    ? `${pageTitle} · ${site.name}`
    : `${site.name} — ${site.tagline}`;
  const description = (typeof metaDescription !== 'undefined' && metaDescription)
    ? metaDescription
    : site.description;
  const canonical = (typeof canonicalUrl !== 'undefined' && canonicalUrl)
    ? canonicalUrl
    : site.url;
  const ogImage = site.url + (site.ogImage || '/images/picture-web.jpg');
%>

<title><%= fullTitle %></title>
<meta name="description" content="<%= description %>" />
<meta name="robots" content="<%= (typeof robots !== 'undefined' && robots) ? robots : 'index, follow, max-image-preview:large' %>" />
<link rel="canonical" href="<%= canonical %>" />

<!-- Open Graph / social -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content="<%= site.name %>" />
<meta property="og:title" content="<%= fullTitle %>" />
<meta property="og:description" content="<%= description %>" />
<meta property="og:url" content="<%= canonical %>" />
<meta property="og:locale" content="<%= site.locale %>" />
<meta property="og:image" content="<%= ogImage %>" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<% if (site.twitter) { %><meta name="twitter:site" content="<%= site.twitter %>" /><% } %>
<meta name="twitter:title" content="<%= fullTitle %>" />
<meta name="twitter:description" content="<%= description %>" />
<meta name="twitter:image" content="<%= ogImage %>" />

<!-- Favicon -->
<link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
<link rel="icon" href="/images/logo-mark.png?v=2" type="image/png" sizes="40x40" />
<link rel="apple-touch-icon" href="/images/logo-mark.png?v=2" />

<!-- Preload the two above-the-fold faces (body = Inter 400, headings = Sora 700)
     so the hero renders in-brand instead of flashing a fallback font. No ?v= —
     these URLs must byte-match the src url() inside fonts.css or the browser
     double-downloads; crossorigin is required (fonts fetch in CORS mode). -->
<link rel="preload" href="/fonts/inter-400-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/sora-700-normal-latin.woff2" as="font" type="font/woff2" crossorigin />

<!-- Fonts are self-hosted (public/css/fonts.css) — no cross-origin CDN, so the
     app can run under cross-origin isolation (COOP/COEP). -->
<link rel="stylesheet" href="/css/fonts.css?v=<%= assetVersion %>" />

<!-- Styles -->
<link rel="stylesheet" href="/css/style.css?v=<%= assetVersion %>" />
<link rel="stylesheet" href="/css/pages.css?v=<%= assetVersion %>" />
<link rel="stylesheet" href="/css/auth.css?v=<%= assetVersion %>" />
<% if (currentPath === '/tools') { %>
<!-- Premium dark Tools index theme — loaded last so it wins, only on "/tools". -->
<link rel="stylesheet" href="/css/tools.css?v=<%= assetVersion %>" />
<% } %>
<% if (currentPath === '/pricing') { %>
<!-- Premium dark Pricing theme — loaded last so it wins, only on "/pricing". -->
<link rel="stylesheet" href="/css/pricing.css?v=<%= assetVersion %>" />
<% } %>
<% if (currentPath === '/about') { %>
<!-- Premium dark About theme — loaded last so it wins, only on "/about". -->
<link rel="stylesheet" href="/css/about.css?v=<%= assetVersion %>" />
<% } %>

<!-- Structured data (nonce-tagged so the strict CSP allows it) -->
<script type="application/ld+json" nonce="<%= nonce %>">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "<%= site.url %>/#organization",
      "name": "<%= site.name %>",
      "url": "<%= site.url %>/",
      "logo": "<%= site.url %>/images/logo-mark.png",
      "description": "<%= site.description %>",
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "customer support",
        "email": "<%= site.contactEmail %>",
        "url": "<%= site.url %>/contact"
      }
    },
    {
      "@type": "WebSite",
      "@id": "<%= site.url %>/#website",
      "url": "<%= site.url %>/",
      "name": "<%= site.name %>",
      "inLanguage": "en-US",
      "publisher": { "@id": "<%= site.url %>/#organization" }
    }
  ]
}
</script>
