<!-- Google Analytics 4 (gtag.js) — Advance Office Doc.
     Loaded globally in the <head> of every page (marketing pages via
     partials/head.ejs, the workspace SPA via layouts/workspace.ejs), so it runs
     on every route exactly once. Measurement ID: G-DJMZ0SVV8P.

     Consent Mode v2: analytics is GRANTED by default so GA collects from every
     visitor on every page (including the workspace, which has no banner). A
     visitor who explicitly declines via the cookie banner (consent.js) is still
     honored — that stored choice turns analytics back off. Advertising stays
     denied. All inline scripts carry the CSP nonce so the strict
     Content-Security-Policy allows them without 'unsafe-inline'. -->
<script nonce="<%= nonce %>">
  window.dataLayer = window.dataLayer || [];
  function gtag(){ dataLayer.push(arguments); }

  // Consent Mode v2 default — analytics is GRANTED by default so GA collects
  // from every visitor. A stored explicit "decline" still turns analytics off;
  // advertising stays denied until (if ever) explicitly allowed.
  (function () {
    var analyticsGranted = true, adGranted = false;
    try {
      var s = JSON.parse(window.localStorage.getItem('alvion:cookie-consent:v2') || 'null');
      if (s && s.v === 2) { analyticsGranted = s.analytics !== false; adGranted = !!s.advertising; }
    } catch (e) { /* storage blocked — default to granted analytics */ }
    gtag('consent', 'default', {
      ad_storage: adGranted ? 'granted' : 'denied',
      ad_user_data: adGranted ? 'granted' : 'denied',
      ad_personalization: adGranted ? 'granted' : 'denied',
      analytics_storage: analyticsGranted ? 'granted' : 'denied',
      functionality_storage: 'granted',
      security_storage: 'granted',
      wait_for_update: 500
    });
  })();

  gtag('js', new Date());
  gtag('config', 'G-DJMZ0SVV8P');

  // SPA support: if any route ever changes the URL client-side (History API),
  // send a fresh page_view. Harmless on the multi-page marketing site (full
  // reloads never trigger it); future-proofs the workspace single-page app.
  (function () {
    var lastPath = location.pathname + location.search;
    function pageView() {
      var p = location.pathname + location.search;
      if (p === lastPath) return;
      lastPath = p;
      gtag('event', 'page_view', {
        page_path: p,
        page_location: location.href,
        page_title: document.title
      });
    }
    ['pushState', 'replaceState'].forEach(function (m) {
      var orig = history[m];
      if (typeof orig !== 'function') return;
      history[m] = function () { var r = orig.apply(this, arguments); pageView(); return r; };
    });
    window.addEventListener('popstate', pageView);
  })();
</script>
<script async src="https://www.googletagmanager.com/gtag/js?id=G-DJMZ0SVV8P" nonce="<%= nonce %>"></script>
